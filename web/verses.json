{
  "cycle": 7400,
  "verses": [
    {
      "at": 1,
      "lines": [
        "殿外的风，自有来处。",
        "此刻的心，也有归处。"
      ]
    },
    {
      "at": 5,
      "lines": [
        "水静时，月影自明。",
        "心静时，方知所往。"
      ]
    },
    {
      "at": 10,
      "lines": [
        "莫催一树花开。",
        "根向深处，也是一程。"
      ]
    },
    {
      "at": 25,
      "lines": [
        "掌中一炷香，终会成灰。",
        "今日一分善，可在人间生根。"
      ]
    },
    {
      "at": 50,
      "lines": [
        "山不因云散而空。",
        "心不因独处而寂。"
      ]
    },
    {
      "at": 100,
      "lines": [
        "听过钟响，再听余音。",
        "余音尽处，还有清风。"
      ]
    }
  ],
  "glyphs": "殿外的风自有来处此刻心也归水静时月影明方知所往莫催一树花开根向深是程掌中炷香终会成灰今日分善可在人间生山不因云散而空独寂听过钟响再余音尽还清",
  "columns": 12
}